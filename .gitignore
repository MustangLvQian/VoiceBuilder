# Machine-specific config (the App path). Copy from the example once.
voicebuilder.config.json

# work/ is a scratch area. Everything in it is produced from the App's question
# banks or from the recordings themselves, so none of it is source.
work/*
!work/.gitkeep

# The downloaded ASR model is large and regenerable.
models/

# Python bytecode from src/*.py
__pycache__/
*.pyc

# ---- phone app (Capacitor) -------------------------------------------------
# Capacitor pulls in ~100 npm packages just to package the APK. The desktop web
# UI itself still has zero dependencies.
node_modules/
# Assembled by `npm run mobile`: the UI plus the transcoded samples.
mobile-dist/
# Generated by `npx cap add android`; regenerate with `npm run mobile:setup`.
# Kept out of git because it is Gradle's scaffolding, not our source.
android/
.gradle/
# Build output
*.apk
*.aab
